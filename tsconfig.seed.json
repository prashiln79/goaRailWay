{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": ".seed-dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["scripts/**/*", "src/data/**/*", "src/types/**/*"]
}
