{
  "expo": {
    "name": "Goa Rail Map",
    "slug": "goaRailWay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Goa Rail Map to use your location to find nearby stations."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#9E3C1B"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.goarailway.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Goa Rail Map to use your location to find nearby stations.",
        "NSLocationAlwaysUsageDescription": "Allow Goa Rail Map to use your location to find nearby stations."
      }
    },
    "android": {
      "package": "com.goarailway.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1A73E8"
      },
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e0afa237-10e4-4923-a798-69f4d5878168"
      }
    }
  }
}
